# ═══════════════════════════════════════════
# Server
# ═══════════════════════════════════════════
NODE_ENV=production
PORT=5000

# ═══════════════════════════════════════════
# Database (Neon PostgreSQL)
# ═══════════════════════════════════════════
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ✅ SSL mode: "disable" (dev) | "require" | "verify-ca" | "verify-full" (prod)
DB_SSL_MODE=require

# ═══════════════════════════════════════════
# JWT (generate: openssl rand -hex 32)
# ═══════════════════════════════════════════
JWT_ACCESS_SECRET=CHANGE_ME_64_CHARS_HEX
JWT_REFRESH_SECRET=CHANGE_ME_64_CHARS_HEX
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=30d

# ═══════════════════════════════════════════
# CORS / API
# ═══════════════════════════════════════════
CORS_ORIGIN=http://localhost:5173,https://your-admin-domain.com
API_BASE_URL=http://localhost:5000

# ═══════════════════════════════════════════
# Firebase Admin (paste JSON as single-line string)
# ═══════════════════════════════════════════
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# ═══════════════════════════════════════════
# Razorpay (payments)
# ═══════════════════════════════════════════
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ═══════════════════════════════════════════
# Cloudinary (image uploads)
# ═══════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══════════════════════════════════════════
# SMTP (email)
# ═══════════════════════════════════════════
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Local Guider

# ═══════════════════════════════════════════
# Redis (Upstash — Mumbai)
# ═══════════════════════════════════════════
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ═══════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════
LOG_LEVEL=info

# ═══════════════════════════════════════════
# Rate limiting
# ═══════════════════════════════════════════
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100